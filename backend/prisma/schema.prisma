generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  ATTENDED
}

enum ChatbotSourceType {
  FAQ
  WORKSHOP
  GUIDANCE
  FALLBACK
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ParentAccount {
  id           Int            @id @default(autoincrement())
  email        String         @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  registrations Registration[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Workshop {
  id                Int            @id @default(autoincrement())
  title             String
  slug              String         @unique
  shortDescription  String
  description       String
  startAt           DateTime
  endAt             DateTime?
  location          String
  recommendedAgeMin Int?
  recommendedAgeMax Int?
  capacity          Int?
  isPublished       Boolean        @default(false)
  registrations     Registration[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([startAt])
  @@index([isPublished])
}

model Registration {
  id             Int                @id @default(autoincrement())
  parentName     String
  parentEmail    String
  parentPhone    String?
  childFirstName String
  childAge       Int
  message        String?
  status         RegistrationStatus @default(PENDING)
  workshopId     Int
  parentAccountId Int?
  workshop       Workshop           @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  parentAccount  ParentAccount?     @relation(fields: [parentAccountId], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([workshopId])
  @@index([status])
  @@index([parentEmail])
  @@index([parentAccountId])
}

model Contact {
  id         Int           @id @default(autoincrement())
  name       String
  email      String
  phone      String?
  message    String
  status     ContactStatus @default(NEW)
  adminNotes String?
  handledAt  DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([email])
  @@index([createdAt])
  @@index([status])
  @@index([updatedAt])
}

model FaqEntry {
  id           Int      @id @default(autoincrement())
  question     String
  answer       String
  category     String?
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([displayOrder])
  @@index([isPublished])
}

model ChatbotMessageLog {
  id                Int               @id @default(autoincrement())
  message           String
  normalizedMessage String
  currentRoute      String?
  sourceType        ChatbotSourceType
  fallbackToContact Boolean           @default(false)
  matchedFaqIds     Int[]
  matchedWorkshopIds Int[]
  reply             String
  createdAt         DateTime          @default(now())

  @@index([sourceType])
  @@index([fallbackToContact])
  @@index([createdAt])
}
